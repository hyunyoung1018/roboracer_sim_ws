<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="${car_name}/imu">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="Red"/>
    </visual>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/imu"/>
    <origin xyz="0.07 0.0 ${wheel_radius+0.04}" rpy="0 0 -1.5708"/>
  </joint>

  <link name="${car_name}/laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://albomb_description_pkg/meshes/UST-10LXB.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Blue"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/laser"/>
    <origin xyz="0.259 0.0 ${wheel_radius+0.0768}" rpy="0 0 0"/>
  </joint>

  
</robot>
