<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="${car_name}/imu">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="Red"/>
    </visual>
  </link>

  <!-- VESC 6 MkVI onboard IMU. Yaw +90 deg, verified on the car by rotating it
       counter-clockwise and watching angular_velocity.z go positive.

       Z is up, not down: VESC Tool's IMU calibration levelled the board with
       roll 7.4 deg and pitch -4.7 deg, which is mounting tilt. A board facing
       the floor would have needed roll near 180. Its Imu Rotation Yaw is 0, so
       the +90 here is the only place the yaw is applied - do not also set it
       in the firmware or it lands twice.

       This joint is the single description of the mounting. controller_manager
       reads it back through TF to rotate the IMU into the car's axes, so
       getting it wrong here silently rotates the controller's yaw rate too. -->
  <joint name="imu_joint" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/imu"/>
    <origin xyz="0.07 0.0 ${wheel_radius+0.04}" rpy="0 0 1.5708"/>
  </joint>

  <link name="${car_name}/laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://albomb_description/meshes/UST-10LXB.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Blue"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/laser"/>
    <origin xyz="0.259 0.0 ${wheel_radius+0.0768}" rpy="0 0 0"/>
  </joint>

  
</robot>
