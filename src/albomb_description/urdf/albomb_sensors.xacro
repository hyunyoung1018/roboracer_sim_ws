<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <link name="${car_name}/imu">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="Red"/>
    </visual>
  </link>

  <!-- VESC 6 MkVI onboard IMU. Yaw +90 deg, verified on the car by rotating it
       counter-clockwise and watching angular_velocity.z go positive.

       OPEN, and it matters for mapping: the board's Z reportedly faces the
       floor. A Z flip is a roll of pi, not a yaw, so this joint may still be
       wrong about which way is down, which is exactly what cartographer uses
       the IMU for. Level and still, linear_acceleration.z should be about
       +9.8; if it is about -9.8, add roll=pi below and re-check the yaw sign,
       because the flip changes it. -->
  <joint name="imu_joint" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/imu"/>
    <origin xyz="0.07 0.0 ${wheel_radius+0.04}" rpy="0 0 1.5708"/>
  </joint>

  <link name="${car_name}/laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://albomb_description/meshes/UST-10LXB.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="Blue"/>
    </visual>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="${car_name}/base_link"/>
    <child link="${car_name}/laser"/>
    <origin xyz="0.259 0.0 ${wheel_radius+0.0768}" rpy="0 0 0"/>
  </joint>

  
</robot>
